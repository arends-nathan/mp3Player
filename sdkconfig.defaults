# Project-wide default configuration. Regenerate sdkconfig by deleting it and
# running `idf.py reconfigure` (or any build) so these defaults are applied.

# Use a custom partition table with a larger app partition for the MP3 decoder
# + WiFi stack. Music is stored on an external SPI SD card (FAT), not in flash.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# HTTPS certificate bundle is required by the manifest/file downloader.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# Long filenames on the SD card's FAT filesystem (track titles can be long).
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# Give the main task a little extra stack for the UI/init path.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=5120

# Bluetooth: classic BT + Bluedroid, used by the Bluetooth settings screen to
# discover nearby devices and stream audio to a speaker/headphones over A2DP.
# BLE is left off to save RAM (we only need classic).
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BT_GAP_BT_ENABLED=y
# A2DP source: stream decoded PCM out to a Bluetooth audio sink. SSP enables
# "just works" pairing without a keypad on the device.
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_SSP_ENABLED=y

# WiFi + Bluetooth coexistence: both radios share the 2.4 GHz front end.
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
